node_modules/
dist/
.angular/
.wrangler/
.dev.vars
# The sandbox Worker's secrets while you upload them (apps/worker/sandbox.secrets.example).
apps/worker/sandbox.secrets
*.log
coverage/
.DS_Store
.claude/worktrees/
# Assembled Workers Static Assets (scripts/assemble-assets.mjs). Not under dist/:
# git can't re-include a file inside an ignored directory, and .gitkeep keeps the
# directory present for wrangler and vitest-pool-workers before anything is built.
apps/worker/site/*
!apps/worker/site/.gitkeep
# End-to-end runs (apps/e2e): the generated Worker config, local database and server log, and Playwright's output.
apps/e2e/.state/
apps/e2e/test-results/
apps/e2e/playwright-report/
