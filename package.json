{
  "name": "tangent",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "build": "pnpm --filter @tangent/web build && pnpm --filter @tangent/simple build && pnpm --filter @tangent/canvas build && pnpm --filter @tangent/admin build && node scripts/assemble-assets.mjs",
    "dev": "pnpm --filter @tangent/worker dev",
    "test": "pnpm -r --workspace-concurrency=1 --no-bail test",
    "coverage": "pnpm -r --workspace-concurrency=1 --no-bail coverage && node scripts/coverage-summary.mjs",
    "e2e": "pnpm --filter @tangent/e2e e2e",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && node scripts/check-provider-neutral.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.11.0",
    "prettier": "^3.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "~4.1.11"
  }
}
