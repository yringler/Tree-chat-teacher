{
  "name": "tangent",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "build": "turbo run assemble",
    "assemble": "node scripts/assemble-assets.mjs",
    "dev": "pnpm --filter @tangent/worker dev",
    "test": "turbo run test --concurrency=1 --continue",
    "coverage": "turbo run coverage --concurrency=1 --continue && node scripts/coverage-summary.mjs",
    "e2e": "pnpm --filter @tangent/e2e e2e",
    "typecheck": "turbo run typecheck && tsc -p scripts/model-eval",
    "lint": "eslint . && node scripts/check-provider-neutral.mjs && node scripts/check-migrations.mjs && node scripts/check-cycles.mjs && node scripts/check-turbo-inputs.mjs",
    "format": "prettier --write . && pnpm --filter @tangent/flutter format",
    "format:check": "prettier --check . && pnpm --filter @tangent/flutter format:check",
    "knip": "knip"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.12.0",
    "knip": "^6.41.0",
    "madge": "8.0.0",
    "prettier": "^3.9.10",
    "turbo": "2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "~4.1.11"
  }
}
