# The sandbox Worker's secrets (README "Sandbox Worker"). Copy to sandbox.secrets (git-ignored),
# fill in, delete the lines you leave empty (an empty line sets an empty secret), then:
#   npx wrangler secret bulk sandbox.secrets --env sandbox
#   rm sandbox.secrets
# Secrets are per Worker: none of production's reach the sandbox, and none of these reach production.

# Fresh values, never production's (`openssl rand -base64 32` each).
BETTER_AUTH_SECRET=
KEY_ENCRYPTION_SECRET=

# Shared with production: the Turnstile widget (add sandbox.tangentailearning.com to its hostnames)
# and Resend (EMAIL_FROM is on the same verified domain).
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=

# Google: production's OAuth client, with
# https://sandbox.tangentailearning.com/api/auth/callback/google added to its redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: a second OAuth app (one callback URL per app),
# https://sandbox.tangentailearning.com/api/auth/callback/github.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# A separate OpenRouter key with a small credit limit. Sandbox payments are fake money, but the
# credit they buy spends this key for real.
OPENROUTER_SIMPLE_API_KEY=

# Polar's sandbox organization (https://sandbox.polar.sh): its organization access token, and the
# secret of its webhook endpoint https://sandbox.tangentailearning.com/api/webhooks/polar.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=

# Optional.
MEMBERSHIP_WAIVER_CODE=

# Your user id in the sandbox's own database (the Account ID in the account menu, after you
# first sign in there); production's ids mean nothing here.
ADMIN_USER_IDS=
