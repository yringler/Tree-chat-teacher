# Copy to .dev.vars for `wrangler dev`. Never commit .dev.vars.
# Values here override the production vars in wrangler.jsonc.

# --- Option A: no sign-in at all (quickest). Honoured only while BETTER_AUTH_SECRET is unset.
# Power mode acts as the `default` account and may use the server keys below; Learn mode
# (/learn/) acts as `default_simple`.
DEV_ALLOW_NO_AUTH=true

# --- Option B: real sign-in, locally. Comment out DEV_ALLOW_NO_AUTH above and fill these in.
# PUBLIC_BASE_URL=http://localhost:8787
# BETTER_AUTH_SECRET=            # openssl rand -base64 32
# Anyone can sign up. Signed-in users never get the server keys below: power mode is bring-your-own-key.
# Magic links are printed to the wrangler console instead of emailed (localhost only):
# EMAIL_PROVIDER=log
# Cloudflare's Turnstile test keys (always pass):
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Optional OAuth apps (callback URLs: http://localhost:8787/api/auth/callback/google and .../github):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# To send real email instead: EMAIL_PROVIDER=resend, RESEND_API_KEY=re_..., EMAIL_FROM=...

# Server-side provider keys: used only by the dev bypass (Option A), never for signed-in users.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
# Enables bring-your-own-key (users paste their own provider key in the UI). 32 random bytes, base64:
#   openssl rand -base64 32
# KEY_ENCRYPTION_SECRET=

# --- Learn mode (/learn/) on paid credit. See README "Learn mode and billing".
# Without these, Learn mode runs only on each learner's own OpenRouter key (needs KEY_ENCRYPTION_SECRET).
# OpenRouter key that paid Learn mode spends (give it a small credit limit). No fallback to OPENROUTER_API_KEY:
# OPENROUTER_SIMPLE_API_KEY=sk-or-...
# Stripe test mode. Both must be set for billing (and for paid credit to be offered at all).
# STRIPE_SECRET_KEY=sk_test_...
# The whsec_... that `stripe listen --forward-to localhost:8787/api/auth/stripe/webhook` prints:
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CREDITS_PRODUCT_ID=prod_...
# STRIPE_PLANS='[{"name":"monthly-10","label":"$10 / month","priceId":"price_...","amountCents":1000}]'

# --- Option C: paid Learn mode offline (no OpenRouter, no Stripe). Works with Option A or B.
# A fake `tangent` provider that reports a fixed cost per call (the shape the worker tests use):
# SIMPLE_PROVIDER='{"id":"tangent","kind":"fake","label":"Tangent","defaultModel":"smart","models":[{"id":"smart","label":"Smart"},{"id":"simple","label":"Simple"}],"options":{"chunkSize":4,"costUsd":0.001234}}'
# Placeholders so sends are allowed (top-ups and plans won't work with them):
# STRIPE_SECRET_KEY=sk_test_placeholder
# STRIPE_WEBHOOK_SECRET=whsec_placeholder
# Then grant yourself credit (5000000 = $5) with the SQL insert into credit_grants from the README
# ("Manual credit or adjustments", with --local; the account is `default_simple` under Option A,
# `u_<your user id>` under Option B), pick "Use paid credit" and chat at http://localhost:8787/learn/.
