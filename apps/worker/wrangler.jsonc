{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Every binding and var is explained in docs/configuration.md; vars left at their default aren't listed.
  "name": "tangent",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  // enable_request_signal: request.signal sees disconnects; nodejs_compat: for Better Auth.
  "compatibility_flags": ["enable_request_signal", "nodejs_compat"],
  // Custom domain only: sign-in works on PUBLIC_BASE_URL alone.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "tangentailearning.com", "custom_domain": true }],
  // Never add logging that captures request headers or bodies: they carry users' API keys.
  "observability": { "enabled": true },
  // Builds the apps into ./site before every deploy and `wrangler dev`, so assets are never empty.
  "build": {
    "command": "pnpm -w build",
    "watch_dir": [
      "../web/src",
      "../simple/src",
      "../canvas/src",
      "../admin/src",
      "../../packages/web-shared/src",
    ],
  },
  "assets": {
    // Assembled by scripts/assemble-assets.mjs: power at /, then learn/, canvas/ and admin/.
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Paths the Worker serves before static assets; keep "/" an exact path.
    "run_worker_first": [
      "/api/*",
      "/s/*",
      "/learn",
      "/learn/*",
      "/canvas",
      "/canvas/*",
      "/admin",
      "/admin/*",
      "/",
      "/welcome",
      "/privacy",
      "/terms",
      "/pool",
      "/pricing",
      "/verify",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tangent",
      // D1 database "tangent" on the owner's account. The deploy job (.github/workflows/ci.yml)
      // applies new migrations (./migrations) just before it deploys, so each one must also work
      // with the code still running: expand first, contract in a later release
      // (docs/operating.md, "Deploying from GitHub"). By hand: `pnpm db:migrate:remote`, then deploy.
      "database_id": "6f9486ed-e5fd-4dfa-b434-10274a650297",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "TREE_SESSION", "class_name": "TreeSession" },
      { "name": "POOL_BANK", "class_name": "PoolBank" },
    ],
  },
  // Durable Object class migrations: append a new tag, never edit an applied one.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TreeSession"] },
    { "tag": "v2", "new_sqlite_classes": ["PoolBank"] },
  ],
  // src/cron.ts dispatches on the cron string: the 10-minute backstops and the daily price sync.
  "triggers": { "crons": ["*/10 * * * *", "23 3 * * *"] },
  "ratelimits": [
    {
      "name": "SHARE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "KEY_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "IMPORT_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  // This deployment's values. Secrets are set with `wrangler secret put` (docs/configuration.md).
  "vars": {
    "PUBLIC_BASE_URL": "https://tangentailearning.com",
    "EMAIL_FROM": "Tangent <login@email.tangentailearning.com>",
    "LEGAL_OPERATOR": "Yehuda Ringler",
    "LEGAL_CONTACT_EMAIL": "privacy@tangentailearning.com",
    "LEGAL_JURISDICTION": "the Commonwealth of Pennsylvania, USA",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFLlFryv5vXul-MG",
    "POLAR_SERVER": "production",
    "POLAR_CREDITS_PRODUCT_ID": "1458ace2-00b3-4710-991e-8d8e04ed4385",
    "POLAR_MEMBERSHIP_PRODUCT_ID": "21924899-92dc-4d9e-b319-75796649f4e7",
    "ANNUAL_FEE_ENABLED": "true",
    "POOL_ENABLED": "true",
    // V4.1 Flash at its pinned providers' price, which wins over the daily sync's list price.
    "MODEL_PRICES": "{\"deepseek/deepseek-v4.1-flash\":{\"in\":150000,\"out\":600000,\"context\":1048576,\"cacheRead\":3000}}",
  },
}
