{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tangent",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  // enable_request_signal: lets us observe client disconnects on request.signal.
  // nodejs_compat: Better Auth needs node:async_hooks (AsyncLocalStorage).
  "compatibility_flags": ["enable_request_signal", "nodejs_compat"],
  // Served only on the custom domain, so PUBLIC_BASE_URL is the only origin sign-in works on.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "tangentailearning.com", "custom_domain": true }],
  // Logs never contain user API keys: our code doesn't log request headers or bodies, the sealed key
  // cookie reaches the Durable Object in a request body, and outbound provider calls aren't logged.
  // Don't add request logging that dumps headers (Cookie) or bodies of /api/key.
  "observability": { "enabled": true },
  // Builds both Angular apps into ./site (root `pnpm build`) before every `wrangler deploy` and
  // `wrangler dev`, so a bare `wrangler deploy` can't ship the empty assets directory: that serves
  // the Worker alone, and /learn/*, /login and every asset 404. Under `wrangler dev` it reruns when
  // the apps' sources change. Workers Builds ignores this key: see "Deploying from Git" in the README.
  "build": {
    "command": "pnpm -w build",
    "watch_dir": ["../web/src", "../simple/src", "../../packages/web-shared/src"]
  },
  "assets": {
    // Assembled by scripts/assemble-assets.mjs (root `pnpm build`): the power app at the
    // root, the simple app under learn/. Holds only .gitkeep until something is built.
    "directory": "./site",
    "binding": "ASSETS",
    // The power app's deep links. SPA fallback always serves the root index.html, so
    // the simple app can't use it: /learn* goes to the Worker (src/http/learn-app.ts).
    "not_found_handling": "single-page-application",
    // API and public share routes must reach the Worker even for browser navigations;
    // /learn* does too, for the simple app's index.html and its CSP. "/welcome" is the
    // landing page, and "/" (exact path) is too for anonymous visitors (src/http/landing.ts).
    // "/privacy" and "/terms" are the public legal pages (src/http/legal.ts).
    "run_worker_first": ["/api/*", "/s/*", "/learn", "/learn/*", "/", "/welcome", "/privacy", "/terms"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tangent",
      // D1 database "tangent" on the owner's account (migrations 0000-0001 applied).
      "database_id": "6f9486ed-e5fd-4dfa-b434-10274a650297",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "TREE_SESSION", "class_name": "TreeSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TreeSession"] }],
  // Usage reconciliation backstop for simple-mode billing (src/billing/reconcile.ts).
  "triggers": { "crons": ["*/10 * * * *"] },
  "ratelimits": [
    {
      "name": "SHARE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      // Requests that spend a user-supplied API key, per key cookie (see src/byok/guard.ts).
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      // Saving a key (each save makes one verification call upstream), per account.
      "name": "KEY_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "vars": {
    // Public origin: share links, sign-in callbacks, magic links and the passkey relying party.
    // Empty = derive from the request URL (local dev and tests only).
    "PUBLIC_BASE_URL": "https://tangentailearning.com",
    // Email delivery for magic links: "resend" (needs RESEND_API_KEY) or "log" (localhost only).
    "EMAIL_PROVIDER": "resend",
    // Sender for magic links; its domain must be verified in Resend.
    "EMAIL_FROM": "Tangent <login@email.tangentailearning.com>",
    // ---- Legal pages (/privacy, /terms; src/http/legal.ts and docs/LEGAL.md).
    // Legal name of whoever runs this deployment (a person or a company); empty = "the operator of <host>".
    "LEGAL_OPERATOR": "Yehuda Ringler",
    // Where privacy requests, legal notices and copyright complaints go. The mailbox must exist
    // (Cloudflare Email Routing can forward it for free). Empty = privacy@<PUBLIC_BASE_URL host>.
    "LEGAL_CONTACT_EMAIL": "privacy@tangentailearning.com",
    // Governing law of the terms, e.g. "the State of New York, USA"; empty = where the operator is established.
    "LEGAL_JURISDICTION": "the United States of America",
    // Cloudflare Turnstile site key (public) for the magic-link form. Its secret is TURNSTILE_SECRET_KEY.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFLlFryv5vXul-MG",
    // JSON array of ProviderConfig; empty = built-in defaults (anthropic, openai, openrouter, fake).
    "PROVIDERS": "",
    // Provider/model for summaries; empty = use the branch's provider/model.
    "SUMMARY_PROVIDER_ID": "",
    "SUMMARY_MODEL": "",
    "AUTO_TITLE": "true",
    // ---- Learn mode (/learn/) and billing. Anyone may sign up and use both apps; Learn runs on the
    // user's own OpenRouter key, or on paid credit once Stripe and OPENROUTER_SIMPLE_API_KEY are set.
    // OpenRouter models for the Smart / Simple tiers (key: OPENROUTER_SIMPLE_API_KEY).
    "SIMPLE_SMART_MODEL": "deepseek/deepseek-v4-pro",
    "SIMPLE_FAST_MODEL": "deepseek/deepseek-v4-flash",
    // Full ProviderConfig JSON for the simple-mode provider `tangent`; empty = OpenRouter with the models above.
    "SIMPLE_PROVIDER": "",
    // Per-request input-token cap for simple accounts (bounds the cost of one call).
    "SIMPLE_MAX_INPUT_TOKENS": "60000",
    // Built-in system prompt of new Learn trees whose account has none saved; empty = DEFAULT_SYSTEM_PROMPT
    // (packages/shared/src/default-prompt.ts), which power mode always uses.
    "SIMPLE_SYSTEM_PROMPT": "",
    // Held per in-flight call, and the minimum available balance to start one (micro-USD; 20000 = $0.02).
    "USAGE_HOLD_MICROS": "20000",
    // OpenRouter's fee on credit purchases in basis points (550 = 5.5%), passed through as part of
    // the provider cost: charge = reported cost × (1 + fee) × (1 + markup). Raise it if you top up
    // OpenRouter in amounts under ~$15, where its $0.80 minimum fee is more than 5.5%.
    "OPENROUTER_FEE_BPS": "550",
    // Margin on the true provider cost in basis points: without / with an active monthly plan.
    "MARKUP_PREPAID_BPS": "1000",
    "MARKUP_MONTHLY_BPS": "500",
    // Stripe product (with a tax code) for one-time credit top-ups.
    "STRIPE_CREDITS_PRODUCT_ID": "",
    // JSON [{ "name", "label", "priceId", "amountCents" }]: monthly credit plans (Better Auth Stripe plugin).
    "STRIPE_PLANS": "[]"
  }
  // Secrets (wrangler secret put): AI_GATEWAY_TOKEN,
  //   KEY_ENCRYPTION_SECRET (`openssl rand -base64 32`; enables bring-your-own-key, rotate to revoke all stored keys)
  //   BETTER_AUTH_SECRET (`openssl rand -base64 32`; signs session cookies, rotate to sign everyone out)
  //   ANTHROPIC_API_KEY, OPENAI_API_KEY, OPENROUTER_API_KEY: not needed in production. Power mode is
  //     bring-your-own-key for every signed-in user; these serve only the local dev bypass (.dev.vars)
  //   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET (each pair optional)
  //   TURNSTILE_SECRET_KEY, RESEND_API_KEY
  //   OPENROUTER_SIMPLE_API_KEY (paid Learn mode only; set a credit limit on it in OpenRouter)
  //   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET (both set = billing enabled)
  // Local only (.dev.vars): DEV_ALLOW_NO_AUTH=true (honoured only while BETTER_AUTH_SECRET is unset)
}
