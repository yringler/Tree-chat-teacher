{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tangent",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  // enable_request_signal: lets us observe client disconnects on request.signal.
  "compatibility_flags": ["enable_request_signal"],
  // Set to false once a custom domain behind Cloudflare Access is configured (see README).
  "workers_dev": true,
  // Logs never contain user API keys: our code doesn't log request headers or bodies, the sealed key
  // cookie reaches the Durable Object in a request body, and outbound provider calls aren't logged.
  // Don't add request logging that dumps headers (Cookie) or bodies of /api/key.
  "observability": { "enabled": true },
  "assets": {
    "directory": "../web/dist/web/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // API and public share routes must reach the Worker even for browser navigations.
    "run_worker_first": ["/api/*", "/s/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tangent",
      // Replace with the id printed by `wrangler d1 create tangent` (README step 2).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "TREE_SESSION", "class_name": "TreeSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TreeSession"] }],
  "ratelimits": [
    {
      "name": "SHARE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      // Requests that spend a user-supplied API key, per key cookie (see src/byok/guard.ts).
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      // Saving a key (each save makes one verification call upstream), per account.
      "name": "KEY_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "vars": {
    // Cloudflare Access: team domain (https://<team>.cloudflareaccess.com) and application AUD tag.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // Public origin used to build share links; empty = derive from the request URL.
    "PUBLIC_BASE_URL": "",
    // JSON array of ProviderConfig; empty = built-in defaults (anthropic, openai, openrouter, fake).
    "PROVIDERS": "",
    // Provider/model for summaries; empty = use the branch's provider/model.
    "SUMMARY_PROVIDER_ID": "",
    "SUMMARY_MODEL": "",
    "AUTO_TITLE": "true"
  }
  // Secrets (wrangler secret put): ANTHROPIC_API_KEY, OPENAI_API_KEY, OPENROUTER_API_KEY, AI_GATEWAY_TOKEN,
  //   KEY_ENCRYPTION_SECRET (`openssl rand -base64 32`; enables bring-your-own-key, rotate to revoke all stored keys)
  // Local only (.dev.vars): DEV_ALLOW_NO_AUTH=true
}
