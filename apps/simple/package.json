{
  "name": "@tangent/simple",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json --serve-path /learn/ --port 4201",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "typecheck": "ngc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@better-auth/passkey": "1.7.7",
    "@tangent/core": "workspace:*",
    "@tangent/render": "workspace:*",
    "@tangent/shared": "workspace:*",
    "@tangent/web-shared": "workspace:*",
    "better-auth": "1.7.7",
    "highlight.js": "^11.12.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "typescript": "~6.0.3",
    "vitest": "~4.1.11"
  }
}
