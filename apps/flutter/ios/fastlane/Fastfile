default_platform(:ios)

platform :ios do
  # Signs the archive that `flutter build ipa --no-codesign` leaves and uploads it to TestFlight.
  # Apple signs it with a cloud-managed distribution certificate, so no machine needs the
  # certificate or a profile: the App Store Connect API key (an Admin key, which cloud signing
  # needs) is all it takes, the same on a laptop and on CI.
  desc "Sign build/ios/archive/Runner.xcarchive and upload it to TestFlight"
  lane :testflight do
    key = connect_api_key

    build_app(
      skip_build_archive: true,
      archive_path: "../build/ios/archive/Runner.xcarchive",
      export_method: "app-store",
      export_options: {
        # Runner's DEVELOPMENT_TEAM: an export takes no team from the archive or the Appfile.
        teamID: "25U5MTYA8U",
        signingStyle: "automatic",
        # The build number is the one flutter build gave the archive.
        manageAppVersionAndBuildNumber: false
      },
      export_xcargs: [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath #{key[:key_path].shellescape}",
        "-authenticationKeyID #{key[:key_id].shellescape}",
        "-authenticationKeyIssuerID #{key[:issuer_id].shellescape}"
      ].join(" "),
      output_directory: "../build/ios/ipa"
    )

    # Processing takes a while and the upload is done by then; waiting would only bill the minutes.
    upload_to_testflight(api_key: key[:api_key], skip_waiting_for_build_processing: true)
  end

  # The simulators shot, by the file name prefix, and the iOS release each runs (its newest
  # installed runtime): the sizes App Store Connect requires (6.9" iPhone, 1320 × 2868; 13" iPad,
  # 2064 × 2752), which it scales down for the others. The iPad is on iPadOS 18 because 26 draws
  # its window-resize grabber in the corner of every app, and neither simctl nor a
  # SpringBoard default turns that off.
  SCREENSHOT_DEVICES = {
    "iphone" => ["iPhone 17 Pro Max", "iOS-26"],
    "ipad" => ["iPad Pro 13-inch (M4)", "iOS-18"]
  }.freeze

  SCREENSHOTS_DIR = File.expand_path("screenshots/en-US", __dir__)

  # The status bar's clock, as a full ISO date: simctl sets the date from it too on the devices
  # that take one, though iPadOS 18's status bar keeps showing today's date beside the time.
  # simctl parses it only with milliseconds and shows it in the simulator's time zone, the Mac's,
  # so it carries the Mac's offset.
  SCREENSHOT_TIME = Time.local(2026, 1, 9, 9, 41).strftime("%Y-%m-%dT%H:%M:%S.000%:z")

  # Runs test_driver/store_app_test.dart on each simulator: the app on its scripted backend,
  # shot with `simctl io` under a fixed status bar. Needs no account and no network.
  desc "Take the App Store screenshots on the simulators into fastlane/screenshots/en-US"
  lane :screenshots do
    flutter_dir = File.expand_path("../..", __dir__)
    FileUtils.rm_rf(SCREENSHOTS_DIR)
    FileUtils.mkdir_p(SCREENSHOTS_DIR)

    SCREENSHOT_DEVICES.each do |prefix, (name, release)|
      udid, was_booted = screenshot_simulator(name, release)
      sh("xcrun", "simctl", "bootstatus", udid, "-b", log: false)
      sh("xcrun", "simctl", "status_bar", udid, "override",
         "--time", SCREENSHOT_TIME, "--dataNetwork", "wifi", "--wifiMode", "active", "--wifiBars", "3",
         "--cellularMode", "active", "--cellularBars", "4", "--operatorName", "",
         # Charged draws a charging bolt; discharging at 100 is a plain full battery.
         "--batteryState", "discharging", "--batteryLevel", "100")
      begin
        Dir.chdir(flutter_dir) do
          sh({ "SCREENSHOT_UDID" => udid, "SCREENSHOT_DIR" => SCREENSHOTS_DIR, "SCREENSHOT_PREFIX" => prefix },
             "flutter", "drive", "--target", "test_driver/store_app.dart", "-d", udid)
        end
      ensure
        sh("xcrun", "simctl", "status_bar", udid, "clear")
        sh("xcrun", "simctl", "shutdown", udid) unless was_booted
      end
    end
    UI.success("Screenshots in #{SCREENSHOTS_DIR}")
  end

  # Replaces every screenshot of the version being prepared with fastlane/screenshots, and
  # touches nothing else: no binary, metadata or version, and no submission.
  desc "Upload fastlane/screenshots to the App Store version being prepared"
  lane :upload_screenshots do
    upload_to_app_store(
      api_key: connect_api_key[:api_key],
      screenshots_path: File.dirname(SCREENSHOTS_DIR),
      overwrite_screenshots: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_app_version_update: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      # No HTML preview to confirm: the screenshots were looked at when they were taken.
      force: true
    )
  end

  # The App Store Connect API key from the environment: fastlane's form of it for its actions, and
  # the id, issuer and file that xcodebuild takes on its command line. The key itself stays in its
  # file and is never printed.
  def connect_api_key
    key_id = ENV.fetch("APP_STORE_CONNECT_KEY_ID")
    issuer_id = ENV.fetch("APP_STORE_CONNECT_ISSUER_ID")
    key_path = File.expand_path(ENV.fetch("APP_STORE_CONNECT_KEY_PATH"))
    {
      api_key: app_store_connect_api_key(key_id: key_id, issuer_id: issuer_id, key_filepath: key_path),
      key_id: key_id,
      issuer_id: issuer_id,
      key_path: key_path
    }
  end

  # The simulator called `name` on the newest installed runtime of `release` ("iOS-26"), and
  # whether it was already running (then it is left running).
  def screenshot_simulator(name, release)
    devices = JSON.parse(sh("xcrun", "simctl", "list", "devices", "available", "--json", log: false))["devices"]
    runtime = devices.keys
                     .select { |r| r.include?("SimRuntime.#{release}-") && devices[r].any? { |d| d["name"] == name } }
                     .max_by { |r| r[/iOS-([\d-]+)/, 1].split("-").map(&:to_i) }
    unless runtime
      UI.user_error!("No #{name} simulator on #{release}: add the runtime and the simulator in " \
                     "Xcode's Settings > Components and Devices and Simulators")
    end
    device = devices[runtime].find { |d| d["name"] == name }
    [device["udid"], device["state"] == "Booted"]
  end
end
