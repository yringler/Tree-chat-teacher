# Workers Static Assets response headers for the Angular app (not /api/* or /s/*,
# which the Worker answers itself; share pages carry their own hash-based CSP).
#
# The browser never talks to an LLM provider directly (connect-src 'self'), no
# inline or remote script runs (the build turns off critical-CSS inlining, which
# needs an inline script), and images are same-origin only so injected markup in
# model output can't exfiltrate data through an <img> URL. Trusted Types limits
# DOM HTML sinks to Angular's sanitizing policies.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types angular angular#bundler
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin

# The login page is the one document allowed to run a third-party script:
# Cloudflare Turnstile (the magic-link captcha), which needs its script and
# iframe from challenges.cloudflare.com. The app only ever reaches /login by a
# full page load and leaves it the same way, so Turnstile never runs in a
# document that holds conversations. Trusted Types is not enforced here: the
# page renders no model output, and Turnstile's script isn't written for it.
/login
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
